alia. Compare FCL, LCL, air freight, DDP, shipping costs, transit times, customs, GST, biosecurity, wooden packaging and destination charges."}],["$","meta","11",{"name":"twitter:image","content":"https://tengyodalogistics.com/images/sea-freight.webp"}],["$","meta","12",{"name":"twitter:image:alt","content":"Container vessel and terminal operations"}],["$","link","13",{"rel":"shortcut icon","href":"/favicon.svg?v=tengyoda-2"}],["$","link","14",{"rel":"icon","href":"/favicon.svg?v=tengyoda-2"}],["$","link","15",{"rel":"canonical","href":"https://tengyodalogistics.com/china-australia.html"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L4",null,{"segmentMap":{"children":["china-australia.html"]},"children":["$","$L5",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L6",null,{"children":["$","$L4",null,{"segmentMap":{"children":[]},"children":["$","$L5",null,{"id":"page:/china-australia.html/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:1xe92f4gszr3o","deploymentVersion":"ba0a1325-edcf-4b09-b603-5c29086c3461","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
