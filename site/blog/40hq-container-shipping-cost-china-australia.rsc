eta","10",{"name":"twitter:description","content":"Learn the cost of shipping a 40HQ container from China to Australia, including ocean freight, origin charges, Australian destination fees, customs, biosecurity and delivery."}],["$","meta","11",{"name":"twitter:image","content":"https://tengyodalogistics.com/assets/images/blog/40hq-china-australia-cover.webp"}],["$","meta","12",{"name":"twitter:image:alt","content":"40HQ container shipping cost from China to Australia"}],["$","link","13",{"rel":"shortcut icon","href":"/favicon.svg?v=tengyoda-2"}],["$","link","14",{"rel":"icon","href":"/favicon.svg?v=tengyoda-2"}],["$","link","15",{"rel":"canonical","href":"https://tengyodalogistics.com/blog/40hq-container-shipping-cost-china-australia/"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L4",null,{"segmentMap":{"children":["blog","40hq-container-shipping-cost-china-australia"]},"children":["$","$L5",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L6",null,{"resetKey":"[\"blog\",\"slug|40hq-container-shipping-cost-china-australia|d\"]","fallback":["$","main",null,{"className":"blog-missing wrap","children":[["$","span",null,{"className":"kicker","children":"404 · TENGYODA BLOG"}],["$","h1",null,{"children":"Article not found"}],["$","p",null,{"children":"这篇文章不存在或已移除。The article may have moved or is no longer available."}],["$","a",null,{"className":"button accent","href":"/blog","children":"返回博客 / Back to the blog"}]]}],"children":["$","$L7",null,{"children":["$","$L4",null,{"segmentMap":{"children":[]},"children":["$","$L5",null,{"id":"page:/blog/40hq-container-shipping-cost-china-australia/"}]}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:899uc81f9pksk","deploymentVersion":"ba0a1325-edcf-4b09-b603-5c29086c3461","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
