4",null,{"segmentMap":{"children":[]},"children":["$","$L5",null,{"id":"page:/blog/avoid-destination-shipping-charges/"}]}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:899uc81f9pksk","deploymentVersion":"ba0a1325-edcf-4b09-b603-5c29086c3461","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
